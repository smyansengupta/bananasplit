# Copy this file to .env and fill in real values. Never commit .env.

# =====================================================================
# Database: any Postgres locally; production is a dedicated Supabase project
# (RUNBOOK, "First deploy"). See docs/ARCHITECTURE.md for the roles.
# =====================================================================
# The owner URL, for migrations and the seed only, NEVER at runtime: the
# owner bypasses RLS because it owns the tables. Production on Supabase
# leaves it unset and uses MIGRATE_DATABASE_URL; with the Neon integration
# (the alternative) it is injected per branch (pooled).
DATABASE_URL="postgresql://user:password@localhost:5432/cbc_suite"

# Optional. Migrations use MIGRATE_DATABASE_URL, then DATABASE_URL_UNPOOLED
# (Neon's direct host), then DATABASE_URL (see prisma.config.ts). On
# Supabase: the owner, postgres.<project-ref>, through the SESSION pooler
# (port 5432), which `prisma migrate deploy` in the Vercel build needs; never
# the transaction pooler. On Vercel the production values of every database
# variable go in the Production scope only (RUNBOOK, "Vercel previews").
MIGRATE_DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Runtime roles (all NOBYPASSRLS, non-owners; created NOLOGIN by the 0B
# migration, given LOGIN out of band):
#   app_user     request code, tenant data under RLS
#   app_service  jobs, crons, no-context paths; fail-closed without an org
#   app_auth     Auth.js adapter, credentials, sign-up, ICS token lookup
# Either set each URL explicitly (local dev, CI, and production on Supabase:
# the transaction pooler, port 6543, with the usernames
# app_user.<project-ref>, app_service.<project-ref> and
# app_auth.<project-ref>)...
DATABASE_URL_APP=""
DATABASE_URL_SERVICE=""
DATABASE_URL_AUTH=""
# ...or leave them empty and set the three passwords: each runtime URL is then
# derived from DATABASE_URL with the role name and password swapped in, which
# is what Neon preview branches use (src/server/db/urls.ts). Derivation
# cannot produce Supabase's role.<project-ref> usernames. Locally,
# prisma/rls/local-roles.sql sets every password to 'test'.
APP_DB_PASSWORD=""
SERVICE_DB_PASSWORD=""
AUTH_DB_PASSWORD=""

# =====================================================================
# Auth.js (NextAuth v5)
# =====================================================================
# Generate with: npx auth secret. Required on every deployment: without it
# Auth.js answers every auth request with a 500 (MissingSecret) and nobody
# can sign in; /api/health fails production:auth_secret.
AUTH_SECRET=""
# Google sign-in client (Cloud Console > APIs & Services > Credentials).
# Sign-in requests only `openid email profile`.
# Currently unused by the UI: "Continue with Google" is hidden on /sign-in
# and /invite, so these can stay empty. The Auth.js provider still reads
# them, ready for when the button comes back. (Google Calendar sync uses
# its own GOOGLE_CALENDAR_CLIENT_ID / _SECRET, below.)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated emails of the platform admins: they may always create
# organizations and they issue org-creation codes at /app/platform/org-codes.
PLATFORM_ADMIN_EMAILS=""
# Master switch for everyone else creating organizations ("true"/"false").
# Defaults to false in production and true elsewhere. While false, only
# platform admins can create orgs, codes cannot be issued and open mode is
# off.
PLATFORM_ORG_CREATION_ENABLED=""
# Who may create an org when the switch is on: "admins" (platform admins
# only), "invite" (anyone with a single-use code, valid 14 days) or "open"
# (any verified user; in production one org per user per 30 days and 20 new
# orgs per day platform-wide). Defaults: "admins" in production, "open"
# elsewhere. Every mode keeps 3 new orgs per user per day.
ORG_CREATION_MODE=""

# =====================================================================
# Secrets at rest (per-org integration secrets: Claude key, Google refresh
# token, Resend key, Supabase password, Netlify hook). AES-256-GCM envelope
# encryption: each secret has its own data key, wrapped by the key
# encryption key (KEK) below. Generate each key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Previews use their own KEK, never production's.
# =====================================================================
# KEK version 1 (base64 of 32 random bytes). Rotation adds SECRETS_KEK_V2 and
# bumps SECRETS_KEK_CURRENT; old versions stay until every secret is rewrapped.
SECRETS_KEK_V1=""
# The version new secrets are wrapped with.
SECRETS_KEK_CURRENT="1"
# HMAC key for the non-reversible secret fingerprint shown in Settings.
SECRETS_FINGERPRINT_KEY=""
# Previews only: "preview" marks the preview keyring. /api/health on a
# preview requires it, and requires PREVIEW_KEK_FINGERPRINT (set only in the
# Vercel Preview scope) to match the configured KEK's fingerprint.
SECRETS_KEK_ENV=""
PREVIEW_KEK_FINGERPRINT=""

# =====================================================================
# Email
# =====================================================================
# Platform sender (account mail, invitations, and org mail under the
# platformMailFallback rule). Production requires both, with EMAIL_FROM on
# the app's own (Resend-verified) domain; /api/health checks it.
RESEND_API_KEY=""

# Email confirmation before an account may create or join an organization.
# Left unset it follows the environment: off on a local machine with no
# sender (the link would only land in .data/mail/), on for every deployment
# and wherever RESEND_API_KEY is set. "true" keeps it on locally too;
# "false" is ignored anywhere it matters.
AUTH_REQUIRE_EMAIL_VERIFICATION=""

EMAIL_FROM="Clubport <no-reply@example.com>"
# "live"  send through Resend (the default when RESEND_API_KEY is set)
# "sink"  never send: write to the console and .data/mail/ (the default
#         locally without a key; previews always behave like this)
# "off"   send nothing; email jobs wait PENDING until delivery is back on
EMAIL_DELIVERY=""

# =====================================================================
# Google Calendar sync (platform OAuth client, separate from sign-in).
# Each org's refresh token is an encrypted OrgSecret, not an env var.
# Calendar API enabled; scopes calendar.events.owned and
# calendar.calendarlist.readonly (see docs/features/calendar.md).
# Without these the gcal jobs fail with "not configured".
# =====================================================================
# Authorized redirect URI: <NEXT_PUBLIC_APP_URL>/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# =====================================================================
# Website data source (Supabase).
#
# SUPABASE_ROOT_CA_PEM (optional): the PEM of Supabase's root CA (dashboard
# > Database settings > SSL configuration > Download certificate), with 

# for newlines. "Test connection" and the sync verify the pooler's
# certificate against it (verify-full); without it the system trust store
# is used, which may reject the pooler's chain. Both paths go through
# src/server/sync/connection.ts, so one value covers them.
#
# SOURCE_SYNC_ALLOW_LOCAL: local development only, and never on Vercel.
# Lets an org's data source point at the stand-in database built by
# scripts/source-sync-standin.ts (config mode "local"), so the connection
# test and the sync can be exercised end to end without a real project.
# =====================================================================
SUPABASE_ROOT_CA_PEM=""
SOURCE_SYNC_ALLOW_LOCAL=""

# =====================================================================
# File storage (Vercel Blob). With no tokens, files go to .data/blob/
# (public files are served by the dev-only /api/dev/blob route). On Vercel
# both tokens are required.
# =====================================================================
# Private store: receipts, org-chart sources, exports.
BLOB_READ_WRITE_TOKEN=""
# Public store: avatars and logos.
BLOB_PUBLIC_READ_WRITE_TOKEN=""
# Previews only (Preview scope): the preview stores' ids, which /api/health
# compares with the configured tokens so a preview never holds production's.
PREVIEW_BLOB_STORE_ID=""
PREVIEW_PUBLIC_BLOB_STORE_ID=""

# =====================================================================
# Cron and the job queue
# =====================================================================
# Required: /api/cron/* and /api/cron/jobs fail closed without it (503).
# Vercel Cron and the GitHub Actions pinger send it as
# `Authorization: Bearer <value>`; it also unlocks the detailed /api/health.
# Generate with: openssl rand -hex 32
CRON_SECRET=""
# Previews behind Vercel Deployment Protection: lets the job kick reach
# /api/cron/jobs on the same deployment.
VERCEL_AUTOMATION_BYPASS_SECRET=""
# Locally, run due jobs with `pnpm jobs:drain` (or `pnpm jobs:drain --watch`).

# =====================================================================
# Live collaboration on notes (docs/features/collaboration.md). OFF unless
# all three app settings are set; half-configured, notes keep the autosave
# editor and the server log says why once. Needs the collaboration server
# (`pnpm collab:dev` locally, `pnpm collab:start` on its own host).
# =====================================================================
# "true" turns it on. Leave it unset in the Vercel Preview scope unless
# previews have their own collaboration server.
COLLAB_ENABLED=""
# Where browsers connect: wss://... (ws:// only on localhost). Added to the
# CSP's connect-src while collaboration is on. Locally: ws://localhost:1234
COLLAB_SERVER_URL=""
# Shared with the collaboration server, which needs the same value: signs the
# editors' 5-minute tokens and the server-to-server calls. At least 32
# characters. Generate with: openssl rand -base64 48
COLLAB_SECRET=""
# The collaboration server's own settings (set on its host, not Vercel):
# the app origin it saves notes through (default NEXT_PUBLIC_APP_URL), and
# the port it listens on (default 1234; a platform's PORT also works).
COLLAB_APP_URL=""
COLLAB_PORT=""

# =====================================================================
# Logs
# =====================================================================
# The console scrubber redacts emails, tokens and keys from server logs. On
# by default in production; "on" or "off" to override.
LOG_SCRUB=""

# =====================================================================
# Error monitoring (Sentry)
# =====================================================================
# From the Sentry project's Settings > Client Keys (DSN). Leave blank to
# disable reporting (errors just log to the console instead).
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed to upload source maps at build time (Vercel dashboard build,
# not local dev). From Sentry > Settings > Auth Tokens.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# =====================================================================
# App
# =====================================================================
# Base URL used to build absolute links in emails and the ICS feed (never
# the request's Host header). Vercel previews use their own VERCEL_URL.
# Production without it uses https://$VERCEL_PROJECT_PRODUCTION_URL (Vercel's
# system variable for the project's production domain; needs "Automatically
# expose System Environment Variables" on). With neither, or with a
# localhost value, production refuses to build links (AppUrlConfigError:
# email jobs fail with it as lastError, /api/health fails production:app_url)
# rather than mailing a localhost link. Off Vercel it defaults to
# http://localhost:3000.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Content Security Policy mode. The policy is enforced everywhere unless this
# is set to "report-only", which sends Content-Security-Policy-Report-Only
# instead: use it to trial a policy change for a week and read the
# /api/csp-report logs (RUNBOOK "Security switches"). Leave it empty.
CSP_MODE=""

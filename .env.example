# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (Neon or any Postgres) ---
# Connection string used by Prisma at runtime and for migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/cbc_portal"

# --- Auth.js (NextAuth v5) ---
# Generate with: npx auth secret
AUTH_SECRET=""
# Google OAuth credentials (Cloud Console > APIs & Services > Credentials).
# Only request `openid email profile` — no Calendar scopes in v1.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email (Resend) ---
# Used for invitations, RSVP notifications, and finance notifications.
RESEND_API_KEY=""
EMAIL_FROM="CBC Portal <no-reply@example.com>"

# --- File storage (receipts only, Phase 5) ---
# Vercel Blob read/write token, or Cloudflare R2 credentials.
BLOB_READ_WRITE_TOKEN=""

# --- Cron (Vercel Cron -> finance-digest, due-date-digest) ---
# Random secret; Vercel Cron sends it as `Authorization: Bearer <value>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Error monitoring (Sentry, spec 6.6) ---
# From the Sentry project's Settings > Client Keys (DSN). Leave blank to
# disable reporting (errors just log to the console instead).
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed to upload source maps at build time (Vercel dashboard build,
# not local dev). From Sentry > Settings > Auth Tokens.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- App ---
# Base URL used to build absolute links in emails and the ICS feed.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Copy this file to .env and fill in real values. Never commit .env.

# =====================================================================
# Database (Neon or any Postgres). See docs/ARCHITECTURE.md for the roles.
# =====================================================================
# The owner URL. On Vercel the Neon integration injects it per branch
# (pooled). It is used for migrations and the seed only, NEVER at runtime:
# the owner bypasses RLS because it owns the tables.
DATABASE_URL="postgresql://user:password@localhost:5432/cbc_suite"

# Optional. Migrations use MIGRATE_DATABASE_URL, then DATABASE_URL_UNPOOLED
# (Neon's direct host), then DATABASE_URL (see prisma.config.ts).
MIGRATE_DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Runtime roles (all NOBYPASSRLS, non-owners; created NOLOGIN by the 0B
# migration, given LOGIN out of band):
#   app_user     request code, tenant data under RLS
#   app_service  jobs, crons, no-context paths; fail-closed without an org
#   app_auth     Auth.js adapter, credentials, sign-up, ICS token lookup
#   app_legacy   temporary strangler role for the not-yet-migrated modules
# Either set each URL explicitly (local dev and CI)...
DATABASE_URL_APP=""
DATABASE_URL_SERVICE=""
DATABASE_URL_AUTH=""
DATABASE_URL_LEGACY=""
# ...or leave them empty and set the four passwords: each runtime URL is then
# derived from DATABASE_URL with the role name and password swapped in, which
# is what Neon preview branches use (src/server/db/urls.ts). Locally,
# prisma/rls/local-roles.sql sets every password to 'test'.
APP_DB_PASSWORD=""
SERVICE_DB_PASSWORD=""
AUTH_DB_PASSWORD=""
LEGACY_DB_PASSWORD=""

# =====================================================================
# Auth.js (NextAuth v5)
# =====================================================================
# Generate with: npx auth secret
AUTH_SECRET=""
# Google sign-in client (Cloud Console > APIs & Services > Credentials).
# Sign-in requests only `openid email profile`.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated emails allowed to create organizations and issue
# org-creation codes (platform admins).
PLATFORM_ADMIN_EMAILS=""
# Who may create an org: "admins" (PLATFORM_ADMIN_EMAILS only), "invite"
# (anyone with a single-use org-creation code) or "open".
ORG_CREATION_MODE="admins"

# =====================================================================
# Secrets at rest (per-org integration secrets: Claude key, Google refresh
# token, Resend key, Supabase password, Netlify hook). AES-256-GCM envelope
# encryption: each secret has its own data key, wrapped by the key
# encryption key (KEK) below. Generate each key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Previews use their own KEK, never production's.
# =====================================================================
# KEK version 1 (base64 of 32 random bytes). Rotation adds SECRETS_KEK_V2 and
# bumps SECRETS_KEK_CURRENT; old versions stay until every secret is rewrapped.
SECRETS_KEK_V1=""
# The version new secrets are wrapped with.
SECRETS_KEK_CURRENT="1"
# HMAC key for the non-reversible secret fingerprint shown in Settings.
SECRETS_FINGERPRINT_KEY=""

# =====================================================================
# Email
# =====================================================================
# Platform sender (account mail, invitations, and org mail under the
# platformMailFallback rule). With no key, mail is written to the console
# and .data/mail/ instead of being sent.
RESEND_API_KEY=""
EMAIL_FROM="CBC Portal <no-reply@example.com>"
# "live" sends through Resend; "sink" never sends (previews, CI).
EMAIL_DELIVERY=""

# =====================================================================
# Google Calendar sync (platform OAuth client, separate from sign-in).
# Each org's refresh token is an encrypted OrgSecret, not an env var.
# =====================================================================
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# =====================================================================
# File storage (Vercel Blob). With no tokens, files go to .data/blob/.
# =====================================================================
# Private store: receipts, org-chart sources, exports.
BLOB_READ_WRITE_TOKEN=""
# Public store: avatars and logos.
BLOB_PUBLIC_READ_WRITE_TOKEN=""

# =====================================================================
# Cron and the job queue
# =====================================================================
# Required: /api/cron/* and /api/cron/jobs fail closed without it. Vercel Cron
# and the GitHub Actions pinger send it as `Authorization: Bearer <value>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# =====================================================================
# Error monitoring (Sentry)
# =====================================================================
# From the Sentry project's Settings > Client Keys (DSN). Leave blank to
# disable reporting (errors just log to the console instead).
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed to upload source maps at build time (Vercel dashboard build,
# not local dev). From Sentry > Settings > Auth Tokens.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# =====================================================================
# App
# =====================================================================
# Base URL used to build absolute links in emails and the ICS feed.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
